[Unit]
Description=J10 PT1 MAVLink bridge (CV shared-memory velocity commands -> CUAV V7 Nano)
# Runs independently of the CV node by design (microservice pattern): it must come up and
# fail safe to hover even if the CV node's own unit hasn't started yet.
After=network.target
Wants=j10-cv-node.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/J10/companion
ExecStart=/usr/bin/python3 -m mavlink_bridge
Restart=on-failure
RestartSec=2

# Companion-computer control loop: keep it responsive under Pi Zero 2W CPU contention
# (e.g. from the camera/CV process sharing the same quad-core SoC).
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

Environment=J10_BRIDGE_SERIAL_PORT=/dev/serial0
Environment=J10_BRIDGE_BAUD=921600
Environment=J10_BRIDGE_SETPOINT_RATE_HZ=20
Environment=J10_BRIDGE_LOG_LEVEL=INFO
# Uncomment only once bench-verified: keeps this bridge from ever touching flight mode.
# Environment=J10_BRIDGE_AUTO_REQUEST_GUIDED_MODE=false

[Install]
WantedBy=multi-user.target
