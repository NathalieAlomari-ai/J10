# External sources for the J10 workspace.
#   vcs import src < j10.repos
#
# MAVROS is available as a binary (ros-humble-mavros ros-humble-mavros-extras) and is
# preferred that way; it is listed here only for builds that need to patch it.
# After installing MAVROS, fetch the GeographicLib datasets once:
#   ros2 run mavros install_geographiclib_datasets.sh

repositories:
  ardupilot_gazebo:
    type: git
    url: https://github.com/ArduPilot/ardupilot_gazebo.git
    version: main
