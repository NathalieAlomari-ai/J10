<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>j10_bringup</name>
  <version>0.1.0</version>
  <description>
    Composite launch files. autonomy.launch.py starts the VLA, motion controller, safety
    filter and mission manager together, on top of an already-running vehicle link. Holds
    no nodes and no logic of its own.
  </description>
  <maintainer email="info@jnhsystems.com">JNH Systems</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>j10_safety</exec_depend>
  <exec_depend>j10_control</exec_depend>
  <exec_depend>j10_vla</exec_depend>
  <exec_depend>j10_mission</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
