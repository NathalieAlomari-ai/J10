# ArduCopter SITL parameters for indoor, GPS-denied flight on simulated optical flow and
# rangefinder. Loaded by scripts/run_sitl.sh via sim_vehicle.py --add-param-file.
#
# This mirrors docs/ARCHITECTURE.md section 7. It is the SITL block only — the real MTF-01
# over MSP uses the same EK3_SRC1_* lines with different sensor type IDs, and those must be
# checked against the current ArduPilot MTF-01 wiki page before first flight.

# --- Airframe ----------------------------------------------------------------------------
# Standard quad-X, matching the iris_with_standoffs model this world spawns. Explicit
# because it was found missing during the Phase 1 arming investigation: `ros2 param get`
# through mavros returned "Parameter not set" for both, and the FCU logged a persistent
# "PreArm: Motors: Check frame class and type" on every SITL run regardless of ARMING_CHECK.
FRAME_CLASS     1
FRAME_TYPE      1

# --- EKF3 on, GPS off -------------------------------------------------------------------
AHRS_EKF_TYPE   3
EK3_ENABLE      1
GPS_TYPE        0

# Source set 1: horizontal position/velocity from optical flow, vertical from baro.
#
# EK3_SRC1_POSZ was originally 2 (RangeFinder), matching the architecture doc's target
# sensor set for the real MTF-01. Left at that value, ArduCopter refuses to arm in SITL
# with a persistent "PreArm: Rangefinder 1: No Data" -- confirmed via /j10/vehicle/state
# showing rangefinder_valid: false / rangefinder_range: nan, and this specific PreArm
# check is NOT gated by ARMING_CHECK=0 (it stayed even with every other check disabled).
# Root cause: the iris_with_standoffs model this world spawns has no distance sensor of
# its own (confirmed against its SDF), so RNGFND1_TYPE=100 (SITL simulated rangefinder)
# never actually produces a reading here regardless of MAVROS/mavlink_bridge config.
#
# Set to 1 (Baro) instead: SITL's simulated barometer works with zero extra setup, and
# Phase 1's exit criterion only needs a working vertical estimate to arm/hover/move on
# command -- it does not require proving rangefinder-based altitude hold, which is later
# (Phase 6) scope. Fixing the simulated rangefinder itself is tracked as a follow-up and
# does not block Phase 1.
EK3_SRC1_POSXY  0
EK3_SRC1_VELXY  5
EK3_SRC1_POSZ   1
EK3_SRC1_VELZ   0
EK3_SRC1_YAW    1

# --- Simulated optical flow -------------------------------------------------------------
SIM_FLOW_ENABLE 1
FLOW_TYPE       10

# --- Simulated rangefinder --------------------------------------------------------------
RNGFND1_TYPE    100
RNGFND1_ORIENT  25
RNGFND1_MIN_CM  5
RNGFND1_MAX_CM  800
SIM_SONAR_SCALE 10

# --- Telemetry stream rates --------------------------------------------------------------
# ESTIMATOR_STATUS (and PID_TUNING, VIBRATION, ...) live in ArduPilot's "EXTRA4" message
# group, which is NOT part of MAVProxy's default stream request and is not requested by
# MAVROS's sys_status plugin either -- confirmed by reading mavros's sys_status.cpp: it
# subscribes and publishes /mavros/estimator_status, but never sends REQUEST_DATA_STREAM or
# SET_MESSAGE_INTERVAL to ask the FCU to actually send it. Both of those runtime request
# mechanisms were also tried live against this SITL build and both failed outright
# (`/mavros/set_stream_rate` had no visible effect; `/mavros/set_message_interval` for
# message id 230 came back success=false) -- this ArduPilot build does not seem to honour
# either at runtime. Setting the stream rate here, at boot, is the one path that has
# actually worked all session for every other ArduPilot-side setting (FRAME_CLASS,
# GPS_TYPE, EK3_SRC1_POSZ all only took effect via this file + a wiped eeprom).
#
# Without this, vehicle_state_node's ekf_healthy stays false forever -- not because the
# EKF isn't healthy, but because /mavros/estimator_status never receives a single message,
# so the ekf_healthy computation (which only runs once estimator_.valid is true) never
# executes at all. SR0 because MAVProxy's master link binds ArduCopter's first serial
# channel (SERIAL0/telem1) in this SITL setup.
SR0_EXTRA4      4

# --- Arming and failsafes for a bench SITL run ------------------------------------------
# Indoors there is no GPS and no RC transmitter attached to SITL, so the corresponding
# prearm checks and failsafes would block every test. These relaxations are SITL-only and
# must NOT be carried into a real airframe parameter set.
ARMING_CHECK    0
FS_THR_ENABLE   0
FS_GCS_ENABLE   0
BRD_SAFETYENABLE 0

# ArduCopter auto-disarms an idle armed-but-landed vehicle after DISARM_DELAY seconds (10s
# default) of near-zero throttle -- confirmed live: "FCU: Arming motors" followed by
# "FCU: Disarming motors" ~15s later on every SITL arm attempt this session, with no
# commanded motion in between. Because MAVROS's own arm service hangs on this ArduPilot
# build (see mavros_apm.yaml's fcu_url comment) and arming has to be done by hand through
# MAVProxy's console instead, that ~10-15s window was nowhere near enough time to also
# switch to GUIDED and get a real velocity command onto /j10/cmd_vel_safe by hand across
# several terminals. 0 disables the auto-disarm entirely so there's no clock to race while
# proving the Phase 1 exit criterion. SITL bench-testing convenience only -- a real airframe
# must keep its normal auto-disarm behaviour.
DISARM_DELAY    0

# --- Guided mode behaviour ---------------------------------------------------------------
# The bridge streams setpoints at 30 Hz continuously, so this timeout should never trip.
# Left at the default value explicitly so a change in ArduPilot defaults is visible here.
GUID_TIMEOUT    3

# Conservative indoor envelope. The safety filter enforces its own limits independently in
# Phase 2; these are the flight controller's backstop.
PILOT_SPEED_UP  100
PILOT_SPEED_DN  100
WPNAV_SPEED     150
WPNAV_SPEED_UP  100
WPNAV_SPEED_DN  100
ANGLE_MAX       1500
